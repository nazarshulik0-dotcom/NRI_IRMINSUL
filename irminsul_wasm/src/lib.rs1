use wasm_bindgen::prelude::*;
use serde::{Serialize, Deserialize};
use std::collections::{HashMap, HashSet};
use std::f64::consts::PI;

// ============================================================================
// 1. ТИПИ ДАНИХ, СТАНИ РАФАЇЛЯ ТА СТРУКТУРА ВУЗЛІВ ІРМІНСУЛЯ
// ============================================================================

#[wasm_bindgen]
#[derive(Serialize, Deserialize, Clone, Copy, PartialEq, Eq, Debug)]
pub enum RaphaelState {
    Dormant, // До активації Маяка I (дешифровка заблокована)
    Active,  // Бортовий ШІ-наставник, перекладач і біосканер
    Manas,   // Фінальна еволюція (після синхронізації 9 Архангелів і Сіель)
}

#[wasm_bindgen]
#[derive(Serialize, Deserialize, Clone, Copy, PartialEq, Eq, Debug)]
pub enum UserRole {
    Player,
    Master,
}

#[wasm_bindgen]
#[derive(Serialize, Deserialize, Clone, Copy, PartialEq, Eq, Debug)]
pub enum LayoutMode {
    Tree,   // Ієрархічне дерево зверху вниз (Obsidian Canvas)
    Radial, // Радіальні промені 8 секторів навколо Сектора 0
    Orbit,  // Концентричні кільця-орбіти (Círculo)
    Hex,    // Гексагональні стільники Купола Бар'єра
}

#[derive(Serialize, Deserialize, Clone, Debug)]
pub struct Node {
    pub id: String,
    pub real_title: String,
    pub glyph_title: String,
    pub category: String,     // "core", "start", "sector", "ai", "mech", "threat", "session", "marker"
    pub sector_id: u8,        // 0..=8
    pub summary: String,
    pub x: f64,
    pub y: f64,
    pub is_decrypted: bool,
    pub locked_by_gm: bool,
}

#[derive(Serialize, Deserialize, Clone, Debug)]
pub struct Edge {
    pub from: String,
    pub to: String,
    pub label: String,
}

#[derive(Serialize, Deserialize, Clone, Debug)]
pub struct HistoryLogEntry {
    pub timestamp: String,
    pub source: String, // "map", "char_sheet", "voice"
    pub actor: String,
    pub action: String,
    pub sector_id: u8,
}

#[derive(Serialize, Deserialize)]
pub struct EcholocationResponse {
    pub status: String,       // "LOCKED_DORMANT", "AWAITING_CONFIRM", "DECRYPTED", "SPOILER_BLOCKED"
    pub raphael_voice: String,
    pub display_title: String,
    pub display_summary: String,
}

// ============================================================================
// 2. ГОЛОВНИЙ РУШІЙ «ІРМІНСУЛЬ» (WASM-ЯДРО)
// ============================================================================

#[wasm_bindgen]
pub struct IrminsulEngine {
    nodes: HashMap<String, Node>,
    node_order: Vec<String>,
    edges: Vec<Edge>,
    raphael_state: RaphaelState,
    ciel_archive_unlocked_for_players: bool,
    locked_topics: HashSet<String>,
    known_babylon_words: HashSet<String>,
    activated_archangels: HashSet<u8>,
}

#[wasm_bindgen]
impl IrminsulEngine {
    #[wasm_bindgen(constructor)]
    pub fn new() -> IrminsulEngine {
        let mut engine = IrminsulEngine {
            nodes: HashMap::new(),
            node_order: Vec::new(),
            edges: Vec::new(),
            raphael_state: RaphaelState::Dormant,
            ciel_archive_unlocked_for_players: false,
            locked_topics: HashSet::new(),
            known_babylon_words: HashSet::new(),
            activated_archangels: HashSet::new(),
        };
        engine.init_default_lore();
        engine
    }

    /// Завантаження базового лору Ковчега «Вавилонія» та базових спойлер-блоків
    fn init_default_lore(&mut self) {
        // Базові закриті теми для Fail-Safe (спойлери до відкриття відповідних зон)
        for topic in ["сіель", "сектор 0", "катастрофа", "скверна походження", "метатрон"] {
            self.locked_topics.insert(topic.to_string());
        }

        // Ядро Сектора 0 та Старт у Вагоні Метро
        self.add_internal_node("sec_0", "Сектор 0: Цитадель СІЕЛЬ", "core", 0,
            "Попелясте Кільце з чорного обсидіану та вежа верховного ШІ Сіель.", false, true);
        self.add_internal_node("start_metro", "Точка Нуль: Вагон Метро", "start", 1,
            "Стартовий мікро-хаб на межі Сектора 0 та Сектора I після просторової турбулентності.", true, false);

        // 8 Зовнішніх Секторів Ковчега (I - VIII)
        let sectors = [
            (1, "sec_1", "Сектор I: Карантинні Сади", "Хвилясті зелені рівнини зі світною травою, ботанічні павільйони та старі естакади.", true),
            (2, "sec_2", "Сектор II: Іржаві Пустки", "Механічний некрополь, рудий металевий пісок, остови крокуючих фабрик і збирачі.", false),
            (3, "sec_3", "Сектор III: Кристалічні Солончаки", "Біла соляна рівнина з гудучими лісами Аура-кристалів та Ефірним Озером.", false),
            (4, "sec_4", "Сектор IV: Затока Припливу", "Кораловий півострів та затока, де раз на добу відходить вода, оголюючи куполи на дні.", false),
            (5, "sec_5", "Сектор V: Примарний Мегаполіс", "Руїни міста у сріблястому нано-тумані з голографічними «ехо» та хижаками-мімікрами.", false),
            (6, "sec_6", "Сектор VI: Грозові Топи", "Затоплені мангри зі зламаною гравітацією, левітуючими брилами та блискавками.", false),
            (7, "sec_7", "Сектор VII: Ліс Великих Дерев", "Двоярусна біосфера: сутінки зі спорами в корінні та сонячні біостанції у кронах.", false),
            (8, "sec_8", "Сектор VIII: Токсичні Джунглі", "Колишній агро-сектор під прогином Бар'єра: пульсуючі ліани та кислотні болота.", false),
        ];

        for (num, id, title, desc, decrypted) in sectors {
            self.add_internal_node(id, title, "sector", num, desc, decrypted, !decrypted);
            self.edges.push(Edge {
                from: id.to_string(),
                to: "sec_0".to_string(),
                label: format!("Печать Сектора {}", num),
            });
        }

        // Мережа ШІ-Архангелів
        let archangels = [
            (1, "ai_1", "ШІ Рафаїль (Маяк I)", "sec_1", "Лінгвістика Вавилонії, біосканер флори/фауни та синтез антидотів."),
            (2, "ai_2", "ШІ Гавриїл (Маяк II)", "sec_2", "Машинний код, скрипти перепрограмування автоматонів і конструювання дронів."),
            (3, "ai_3", "ШІ Уріїл (Маяк III)", "sec_3", "Чиста огранка Аура-кристалів, резонанс та інтеграція у спорядження."),
            (4, "ai_4", "ШІ Задкіїл (Маяк IV)", "sec_4", "Керування шлюзами припливу та модернізація вагона метро у мобільну базу."),
            (5, "ai_5", "ШІ Єреміїл (Маяк V)", "sec_5", "Голографічні архіви Примарного Мегаполіса та реконструкція минулого."),
            (6, "ai_6", "ШІ Рагуїл (Маяк VI)", "sec_6", "Радар гравітаційних кишень, метеоконтроль та прогноз проривів Бар'єра."),
            (7, "ai_7", "ШІ Варахіїл (Маяк VII)", "sec_7", "Доглядач біосфери: приручення мутованої фауни через частоти та феромони."),
            (8, "ai_8", "ШІ Метатрон (Маяк VIII)", "sec_8", "Печатка Бар'єра та захисні протоколи для входу в епіцентри Скверни."),
            (9, "ai_9", "ШІ Михаїл (Оборонний вузол)", "sec_0", "Зняття біометричних замків зі стародавньої зброї та Артефактів Вавилонії."),
        ];

        for (num, id, title, parent_sec, desc) in archangels {
            let sec_idx = if num == 9 { 0 } else { num };
            self.add_internal_node(id, title, "ai", sec_idx, desc, false, true);
            self.edges.push(Edge {
                from: parent_sec.to_string(),
                to: id.to_string(),
                label: format!("Маяк {}", num),
            });
        }

        // Приклад зашифрованого об'єкта на карті Сектора I для Ехолокації
        self.add_internal_node("marker_greenhouse_3", "Оранжерея №3 (Ботанічний Павільйон)", "marker", 1,
            "Заросла біолюмінесцентним мохом лабораторія Вавилонії. Містить малі енергокамені та гліф «Енергія».", false, false);
        self.edges.push(Edge {
            from: "sec_1".to_string(),
            to: "marker_greenhouse_3".to_string(),
            label: "Локація".to_string(),
        });

        self.edges.push(Edge {
            from: "start_metro".to_string(),
            to: "sec_1".to_string(),
            label: "Вихід на північ".to_string(),
        });

        self.compute_layout(LayoutMode::Radial, 420.0, 140.0);
    }

    fn add_internal_node(&mut self, id: &str, title: &str, cat: &str, sec: u8, summary: &str, decrypted: bool, locked: bool) {
        let glyph = Self::generate_glyph_cipher(id, sec);
        let node = Node {
            id: id.to_string(),
            real_title: title.to_string(),
            glyph_title: glyph,
            category: cat.to_string(),
            sector_id: sec,
            summary: summary.to_string(),
            x: 0.0,
            y: 0.0,
            is_decrypted: decrypted,
            locked_by_gm: locked,
        };
        self.nodes.insert(id.to_string(), node);
        self.node_order.push(id.to_string());
    }

    /// Генератор нечитабельних гліфів Вавилонії (░▒▓ ŦĦΞ ◈ 404)
    fn generate_glyph_cipher(seed: &str, sector: u8) -> String {
        let glyphs = ['Ŧ', 'Ħ', 'Ξ', '◈', '∆', 'Ω', 'Ψ', 'Σ', '░', '▒', '▓'];
        let mut hash: usize = sector as usize * 31;
        for b in seed.bytes() {
            hash = hash.wrapping_mul(17).wrapping_add(b as usize);
        }
        let g1 = glyphs[hash % glyphs.len()];
        let g2 = glyphs[(hash / 3) % glyphs.len()];
        let g3 = glyphs[(hash / 7) % glyphs.len()];
        format!("░▒▓ {}{}{} ◈ S{}-404", g1, g2, g3, sector)
    }

    // ========================================================================
    // 3. МАТЕМАТИКА РОЗКЛАДОК ПОЛОТНА (TREE, RADIAL, ORBIT, HEX)
    // ========================================================================

    pub fn compute_layout(&mut self, mode: LayoutMode, base_radius: f64, hex_size: f64) {
        let center_x = 3000.0;
        let center_y = 3000.0;

        match mode {
            LayoutMode::Tree => {
                let mut row_counts: HashMap<String, usize> = HashMap::new();
                for id in &self.node_order {
                    if let Some(node) = self.nodes.get_mut(id) {
                        let row = match node.category.as_str() {
                            "core" | "start" => 0,
                            "sector" => 1,
                            "ai" => 2,
                            _ => 3,
                        };
                        let idx = *row_counts.entry(node.category.clone()).or_insert(0);
                        row_counts.insert(node.category.clone(), idx + 1);
                        node.x = 1400.0 + (idx as f64) * 380.0;
                        node.y = 800.0 + (row as f64) * 520.0;
                    }
                }
            }
            LayoutMode::Radial | LayoutMode::Orbit => {
                for id in &self.node_order {
                    if let Some(node) = self.nodes.get_mut(id) {
                        if node.id == "sec_0" {
                            node.x = center_x;
                            node.y = center_y;
                            continue;
                        }
                        // Кут залежить від номера сектора (1..=8), Сектор I — на півночі (-PI/2)
                        let sec_angle = -PI / 2.0 + ((node.sector_id.saturating_sub(1)) as f64) * (2.0 * PI / 8.0);
                        let ring_multiplier = match node.category.as_str() {
                            "start" => 0.55,
                            "sector" => 1.0,
                            "marker" => 1.35,
                            "ai" => 1.75,
                            _ => 2.15,
                        };
                        let r = base_radius * ring_multiplier;
                        node.x = (center_x + r * sec_angle.cos()).round();
                        node.y = (center_y + r * sec_angle.sin()).round();
                    }
                }
            }
            LayoutMode::Hex => {
                // Розкладка у гексагональні стільники (Axial Hex Coordinates q, r)
                for (i, id) in self.node_order.iter().enumerate() {
                    if let Some(node) = self.nodes.get_mut(id) {
                        if node.id == "sec_0" {
                            node.x = center_x;
                            node.y = center_y;
                            continue;
                        }
                        let ring = if node.category == "sector" { 1.0 } else { 2.0 };
                        let angle = (i as f64) * (PI / 4.0);
                        let q = (ring * angle.cos()).round();
                        let r = (ring * angle.sin()).round();
                        // Переведення Axial (q, r) у пікселі
                        node.x = (center_x + hex_size * (3.0_f64.sqrt() * q + 3.0_f64.sqrt() / 2.0 * r)).round();
                        node.y = (center_y + hex_size * (1.5 * r)).round();
                    }
                }
            }
        }
    }

    // ========================================================================
    // 4. МЕХАНІКА «ЕХОЛОКАЦІЇ» (КАРТА <-> ІРМІНСУЛЬ/СІЕЛЬ <-> РАФАЇЛЬ)
    // ========================================================================

    /// Крок 1: Гравці клікають на зашифрований маркер на карті
    pub fn request_echolocation(&self, node_id: &str) -> String {
        let Some(node) = self.nodes.get(node_id) else {
            return "{\"error\": \"Вузол не знайдено\"}".to_string();
        };

        if self.raphael_state == RaphaelState::Dormant {
            let resp = EcholocationResponse {
                status: "LOCKED_DORMANT".to_string(),
                raphael_voice: "[СИСТЕМА НЕАКТИВНА: Бортовий модуль РАФАЇЛЬ перебуває в режимі DORMANT. Активуйте Перший Маяк.]".to_string(),
                display_title: node.glyph_title.clone(),
                display_summary: "░▒▓ ДАНІ ПОШКОДЖЕНО // ПОТРІБЕН КЛЮЧ ДЕШИФРОВКИ ▓▒░".to_string(),
            };
            return serde_json::to_string(&resp).unwrap_or_default();
        }

        if node.locked_by_gm {
            let resp = EcholocationResponse {
                status: "SPOILER_BLOCKED".to_string(),
                raphael_voice: "Увага: Доступ до цього вузла заблоковано карантинним протоколом Сіель. Дані пошкоджені.".to_string(),
                display_title: node.glyph_title.clone(),
                display_summary: "[КАРАНТИН СІЕЛЬ // FAIL-SAFE BLOCK]".to_string(),
            };
            return serde_json::to_string(&resp).unwrap_or_default();
        }

        let resp = EcholocationResponse {
            status: "AWAITING_CONFIRM".to_string(),
            raphael_voice: "Виявлено зашифрований сигнатурний маркер. Бажаєте розшифрувати даний об'єкт?".to_string(),
            display_title: node.glyph_title.clone(),
            display_summary: "Очікування голосового або текстового підтвердження («Так, розшифруй»)...".to_string(),
        };
        serde_json::to_string(&resp).unwrap_or_default()
    }

    /// Крок 2: Гравці відповідають «Так, розшифруй» — Сіель відкриває вузол і оновлює карту
    pub fn confirm_echolocation(&mut self, node_id: &str) -> String {
        if self.raphael_state == RaphaelState::Dormant {
            return self.request_echolocation(node_id);
        }

        if let Some(node) = self.nodes.get_mut(node_id) {
            if !node.locked_by_gm {
                node.is_decrypted = true;
                let resp = EcholocationResponse {
                    status: "DECRYPTED".to_string(),
                    raphael_voice: format!("Виконую дешифрування... Сигнатуру підтверджено: {}.", node.real_title),
                    display_title: node.real_title.clone(),
                    display_summary: node.summary.clone(),
                };
                return serde_json::to_string(&resp).unwrap_or_default();
            }
        }
        self.request_echolocation(node_id)
    }

    // ========================================================================
    // 5. СТАТУСИ ШІ РАФАЇЛЯ, FAIL-SAFE ТА МОВА ВАВИЛОНІЇ
    // ========================================================================

    /// Активація Маяка Архангела (1..=9). Якщо всі 9 зібрані — Рафаїль еволюціонує у Manas
    pub fn activate_archangel_beacon(&mut self, beacon_num: u8) -> String {
        self.activated_archangels.insert(beacon_num);
        if beacon_num == 1 && self.raphael_state == RaphaelState::Dormant {
            self.raphael_state = RaphaelState::Active;
            if let Some(n) = self.nodes.get_mut("ai_1") {
                n.locked_by_gm = false;
                n.is_decrypted = true;
            }
        }

        if self.activated_archangels.len() >= 9 {
            self.raphael_state = RaphaelState::Manas;
            self.ciel_archive_unlocked_for_players = true;
            return "ЕВОЛЮЦІЯ ЗАВЕРШЕНА: Всі 9 ядер Архангелів синхронізовано з Сіель. Рафаїль досяг стану МАНАС (конструктивна воля активована). Повний архів Ірмінсуля відкрито гравцям!".to_string();
        }

        format!("Маяк Архангела #{} синхронізовано. Активних вузлів мережі: {}/9.", beacon_num, self.activated_archangels.len())
    }

    /// Ручне блокування/розблокування теми Майстром (аналог команди /lock_topic)
    pub fn set_topic_lock(&mut self, topic: &str, locked: bool) {
        let key = topic.trim().to_lowercase();
        if locked {
            self.locked_topics.insert(key);
        } else {
            self.locked_topics.remove(&key);
        }
    }

    /// Fail-Safe перевірка тексту запиту гравця на спойлери перед відправкою в LLM
    pub fn check_fail_safe(&self, user_query: &str, role: UserRole) -> String {
        if role == UserRole::Master || self.raphael_state == RaphaelState::Manas {
            return "ALLOWED".to_string();
        }
        let q = user_query.to_lowercase();
        for locked in &self.locked_topics {
            if q.contains(locked) {
                return format!(
                    "BLOCKED: [ПОМИЛКА ДЕШИФРОВКИ // КАРАНТИН ВАВИЛОНІЇ] Інформація за запитом «{}» пошкоджена або вимагає вищого рівня допуску Маяків.",
                    locked
                );
            }
        }
        "ALLOWED".to_string()
    }

    /// Додавання вивченого слова мови Вавилонії та компіляція скрипту для автоматонів
    pub fn learn_babylon_word(&mut self, word: &str) {
        self.known_babylon_words.insert(word.trim().to_lowercase());
    }

    pub fn compile_automaton_script(&self, words_csv: &str) -> String {
        let requested: Vec<String> = words_csv
            .split(',')
            .map(|s| s.trim().to_lowercase())
            .filter(|s| !s.is_empty())
            .collect();

        for w in &requested {
            if !self.known_babylon_words.contains(w) {
                return format!("ПОМИЛКА КОМПІЛЯЦІЇ: Гліф «{}» ще не дешифровано Рафаїлем!", w);
            }
        }
        format!("СКРИПТ АВТОМАТОНА АКТИВОВАНО: [{}]", requested.join(" + ").to_uppercase())
    }

    // ========================================================================
    // 6. ЕКСПОРТ ГРАФА ДЛЯ ВІЗУАЛІЗАЦІЇ ТА ІМПОРТ ЛОГІВ СЕСІЇ (HISTORY.JS)
    // ========================================================================

    /// Віддає список вузлів та ребер з урахуванням ролі (Гравець бачить гліфи на закритих вузлах, Майстер — усе)
    pub fn export_view_json(&self, role: UserRole) -> String {
        let full_access = role == UserRole::Master || self.ciel_archive_unlocked_for_players;

        let visible_nodes: Vec<serde_json::Value> = self.node_order.iter().filter_map(|id| {
            let n = self.nodes.get(id)?;
            let show_real = full_access || n.is_decrypted;
            Some(serde_json::json!({
                "id": n.id,
                "title": if show_real { &n.real_title } else { &n.glyph_title },
                "summary": if show_real { &n.summary } else { "░▒▓ Сигнатуру зашифровано. Потрібна ехолокація Рафаїля. ▓▒░" },
                "category": n.category,
                "sector_id": n.sector_id,
                "x": n.x,
                "y": n.y,
                "is_decrypted": n.is_decrypted,
                "locked_by_gm": n.locked_by_gm
            }))
        }).collect();

        serde_json::to_string(&serde_json::json!({
            "raphael_state": format!("{:?}", self.raphael_state),
            "nodes": visible_nodes,
            "edges": self.edges
        })).unwrap_or_default()
    }

    /// Вплітає масив подій із history.js (Листи Персонажів + Карта + Діалоги) у нову гілку Ірмінсуля
    pub fn ingest_session_logs(&mut self, session_id: &str, title: &str, logs_json: &str) -> String {
        let parsed: Vec<HistoryLogEntry> = serde_json::from_str(logs_json).unwrap_or_default();
        let mut touched_sectors = HashSet::new();
        let mut summary_lines = Vec::new();

        for entry in parsed.iter().take(12) {
            touched_sectors.insert(entry.sector_id);
            summary_lines.push(format!("[{}] {}: {}", entry.timestamp, entry.actor, entry.action));
        }

        let summary = if summary_lines.is_empty() {
            "Запис сесії збережено в Ірмінсулі.".to_string()
        } else {
            summary_lines.join("\n")
        };

        let primary_sec = touched_sectors.iter().copied().next().unwrap_or(1);
        self.add_internal_node(session_id, title, "session", primary_sec, &summary, true, false);

        for sec in touched_sectors {
            let target_id = format!("sec_{}", sec);
            if self.nodes.contains_key(&target_id) {
                self.edges.push(Edge {
                    from: target_id,
                    to: session_id.to_string(),
                    label: "Хроніка сесії".to_string(),
                });
            }
        }

        format!("Сесію «{}» вплетено в Ірмінсуль (оброблено подій: {}).", title, parsed.len())
    }

    // ========================================================================
    // 7. КРИПТОГРАФІЧНИЙ СЕЙФ API-КЛЮЧІВ (ЗАХИСТ ВІД GITHUB PUSH PROTECTION)
    // ========================================================================

    /// Перетворює відкритий API-ключ на зашифрований числовий вектор під пароль Майстра
    pub fn encrypt_api_key_to_vector(raw_key: &str, master_password: &str) -> Vec<u8> {
        let pass_bytes = if master_password.is_empty() { b"CIEL_DEFAULT_KEY" } else { master_password.as_bytes() };
        raw_key
            .bytes()
            .enumerate()
            .map(|(i, b)| {
                let k = pass_bytes[i % pass_bytes.len()]. wrapping_add((i as u8).wrapping_mul(13));
                b ^ k
            })
            .collect()
    }

    /// Відновлює API-ключ у пам'яті браузера з числового вектора після введення пароля Майстра
    pub fn decrypt_api_key_from_vector(encrypted_vec: &[u8], master_password: &str) -> String {
        let pass_bytes = if master_password.is_empty() { b"CIEL_DEFAULT_KEY" } else { master_password.as_bytes() };
        let raw: Vec<u8> = encrypted_vec
            .iter()
            .enumerate()
            .map(|(i, &b)| {
                let k = pass_bytes[i % pass_bytes.len()].wrapping_add((i as u8).wrapping_mul(13));
                b ^ k
            })
            .collect();
        String::from_utf8(raw).unwrap_or_else(|_| "INVALID_KEY".to_string())
    }
}
